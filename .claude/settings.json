{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(properties)",
      "Read(properties/**)",
      "Bash(rm:*)",
      "Bash(gh:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(zsh:*)",
      "Bash(eval:*)",
      "Bash(exec:*)",
      "Bash(env:*)",
      "Bash(xargs:*)",
      "Bash(command:*)",
      "Bash(*git push*)",
      "Bash(*git * push*)",
      "Bash(*git commit*)",
      "Bash(*git * commit*)",
      "Bash(*git checkout*)",
      "Bash(*git * checkout*)",
      "Bash(*git reset*)",
      "Bash(*git * reset*)",
      "Bash(*git rebase*)",
      "Bash(*git * rebase*)",
      "Bash(*git stash*)",
      "Bash(*git * stash*)"
    ]
  }
}
