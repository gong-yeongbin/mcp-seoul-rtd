{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": false,
    "sourceMap": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    // Node 24 는 relative import 에 .ts 확장자를 요구하고(네이티브 타입 스트리핑),
    // tsc 는 컴파일 결과에서 이를 .js 로 바꿔 준다.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"]
}
